# Copy this file to ".env" (same directory) and replace every value.
# ".env" is git-ignored and must never be committed.
#
# In this local development setup a single MySQL user owns both schemas,
# so PW_DB_AUTH_* and PW_DB_APP_* hold the same values (this also matches
# the GRANT statement in init.sql, which uses the user 'admin').
# In a production deployment use two distinct least-privilege users.

# --- MySQL container (read by docker-compose.yml) ---
PW_DB_ROOT_PASS=change-me-root
PW_DB_APP_USER=admin
PW_DB_APP_PASS=change-me

# --- Spring Boot datasource (read by the application) ---
PW_DB_AUTH_URL=jdbc:mysql://localhost:3306/auth_db
PW_DB_APP_URL=jdbc:mysql://localhost:3306/app_db
PW_DB_AUTH_USER=admin
PW_DB_AUTH_PASS=change-me
PW_DB_APP_USER=admin
PW_DB_APP_PASS=change-me

# --- MQTT broker (read by the application) ---
MQTT_BROKER_URL=tcp://localhost:5278
MQTT_BROKER_USER=pw_api
MQTT_BROKER_PASS=change-me

# --- JWT key pair (optional; defaults to the classpath files) ---
# PW_JWT_PUB=file:/etc/pw/app.pub
# PW_JWT_PRIV=file:/etc/pw/app.key
